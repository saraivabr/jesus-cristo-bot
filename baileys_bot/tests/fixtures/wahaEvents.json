  "testScenarios": {
    "scenario_multiuser_conversation": {
      "description": "Simula conversa com múltiplos usuários",
      "steps": [
        {
          "id": "step_1",
          "description": "User A envia mensagem inicial",
          "event": "message",
          "data": {
            "from": "5511999999999@s.whatsapp.net",
            "body": "Olá, preciso conversar",
            "type": "text",
            "timestamp": 1641234567000,
            "pushName": "User A"
          }
        },
        {
          "id": "step_2",
          "description": "Bot responde",
          "type": "bot_response",
          "to": "5511999999999@s.whatsapp.net",
          "body": "Olá! Como posso ajudar?"
        },
        {
          "id": "step_3",
          "description": "User B envia mensagem",
          "event": "message",
          "data": {
            "from": "5512888888888@s.whatsapp.net",
            "body": "Tenho dúvidas sobre fé",
            "type": "text",
            "timestamp": 1641234568000,
            "pushName": "User B"
          }
        }
      ]
    },

    "scenario_group_notification": {
      "description": "Bot postando notificação em grupo",
      "webhook": {
