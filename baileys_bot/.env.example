# ═══════════════════════════════════════════════════════════════
# 🕊️ JESUS CRISTO BOT - CONFIGURAÇÃO
# ═══════════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha os valores

# ═══════════════════════════════════════════════════════════════
# OBRIGATÓRIO
# ═══════════════════════════════════════════════════════════════

# Google Gemini API Key
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# ═══════════════════════════════════════════════════════════════
# WAHA - WhatsApp API Configuration
# ═══════════════════════════════════════════════════════════════

# WAHA server URL
WAHA_URL=https://vv-ddas.v8b0on.easypanel.host

# WAHA API Key for authentication
WAHA_API_KEY=7dcbe043adf54656bd7ac2c3f94c7292

# WAHA session name (used for API calls)
WAHA_SESSION=default

# ═══════════════════════════════════════════════════════════════
# BÁSICO (opcional)
# ═══════════════════════════════════════════════════════════════

# Nome do bot
BOT_NAME=Jesus Cristo

# Ambiente (development ou production)
NODE_ENV=development

# ID da sessão (para múltiplas instâncias)
SESSION_ID=jesus_bot_session

# Debounce - tempo de espera para juntar mensagens (ms)
DEBOUNCE_TIME=10000

# ═══════════════════════════════════════════════════════════════
# TTS - Text-to-Speech (opcional)
# ═══════════════════════════════════════════════════════════════

TTS_ENABLED=false
TTS_LANGUAGE=pt-BR

# ═══════════════════════════════════════════════════════════════
# FOLLOW-UP (opcional)
# ═══════════════════════════════════════════════════════════════

FOLLOWUP_ENABLED=true
FOLLOWUP_MIN_HOURS=1
FOLLOWUP_MAX_HOURS=24

# Horário silencioso - não enviar mensagens
QUIET_HOURS_START=22
QUIET_HOURS_END=8

# ═══════════════════════════════════════════════════════════════
# RATE LIMITING (opcional)
# ═══════════════════════════════════════════════════════════════

MAX_MESSAGES_PER_MINUTE=10
MAX_MESSAGES_PER_HOUR=100

# ═══════════════════════════════════════════════════════════════
# LOGGING (opcional)
# ═══════════════════════════════════════════════════════════════

LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════
# SCALINGO (configurado automaticamente pelo add-on)
# NÃO precisa preencher se estiver usando Scalingo!
# ═══════════════════════════════════════════════════════════════

# PostgreSQL URL (banco de dados principal)
# SCALINGO_POSTGRESQL_URL=

# MongoDB URL (sessão do WhatsApp)
# SCALINGO_MONGO_URL=

# Redis URL (cache)
# SCALINGO_REDIS_URL=

# ═══════════════════════════════════════════════════════════════
# DESENVOLVIMENTO LOCAL COM DOCKER (opcional)
# Use se quiser testar a infraestrutura completa localmente
# ═══════════════════════════════════════════════════════════════

# DATABASE_URL=postgresql://jesus:jesus123@localhost:5432/jesus_bot
# MONGO_URL=mongodb://localhost:27017/jesus_bot
# REDIS_URL=redis://localhost:6379
