# ═══════════════════════════════════════════════════════════════════════════
# JESUS CRISTO BOT - PRODUCTION ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env.production and fill in actual values
# IMPORTANT: Never commit .env.production to git!
#
# For deployment, use:
#   ./deployment/deploy.sh --app your-app --env deployment/.env.production
#
# ═══════════════════════════════════════════════════════════════════════════

# REQUIRED: Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-google-gemini-api-key-here

# REQUIRED: WAHA Configuration (WhatsApp HTTP API)
# WAHA must be deployed separately (e.g., via EasyPanel or Docker)
WAHA_URL=https://vv-xxxx.xxxx.easypanel.host
WAHA_API_KEY=your-waha-api-key-here
WAHA_SESSION=default

# REQUIRED: Node Environment
NODE_ENV=production
PORT=8080

# ═══════════════════════════════════════════════════════════════════════════
# BOT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

BOT_NAME=Jesus Cristo
SESSION_ID=jesus_bot_session
PHONE_NUMBER=5511999999999

# ═══════════════════════════════════════════════════════════════════════════
# MESSAGE PROCESSING
# ═══════════════════════════════════════════════════════════════════════════

# Time to wait for multiple messages (ms)
# Higher value = accumulate more messages before processing
# Lower value = faster response time
DEBOUNCE_TIME=7000

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════════
# FOLLOW-UP CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

FOLLOWUP_ENABLED=true
FOLLOWUP_MIN_HOURS=1
FOLLOWUP_MAX_HOURS=24

# Quiet hours - no automated follow-ups outside these hours
QUIET_HOURS_START=22
QUIET_HOURS_END=8

# ═══════════════════════════════════════════════════════════════════════════
# RATE LIMITING
# ═══════════════════════════════════════════════════════════════════════════

MAX_MESSAGES_PER_MINUTE=10
MAX_MESSAGES_PER_HOUR=100

# ═══════════════════════════════════════════════════════════════════════════
# AUDIO/TTS (Optional)
# ═══════════════════════════════════════════════════════════════════════════

TTS_ENABLED=false
TTS_LANGUAGE=pt-BR

# ═══════════════════════════════════════════════════════════════════════════
# DATABASE URLS (Scalingo Auto-Injected)
# ═══════════════════════════════════════════════════════════════════════════
#
# DO NOT SET THESE MANUALLY!
# Scalingo automatically injects these when add-ons are provisioned:
#
# SCALINGO_POSTGRESQL_URL=postgresql://user:pass@host:port/dbname
# SCALINGO_MONGO_URL=mongodb://user:pass@host:port/dbname
# SCALINGO_REDIS_URL=redis://:pass@host:port
#

# ═══════════════════════════════════════════════════════════════════════════
# MONITORING & EXTERNAL SERVICES (Optional)
# ═══════════════════════════════════════════════════════════════════════════

# Datadog API Key (if using Datadog monitoring)
# DATADOG_API_KEY=your-datadog-api-key

# Sentry DSN (if using Sentry error tracking)
# SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# New Relic License Key (if using New Relic APM)
# NEW_RELIC_LICENSE_KEY=your-new-relic-key

# ═══════════════════════════════════════════════════════════════════════════
# ADVANCED OPTIONS (Usually not needed)
# ═══════════════════════════════════════════════════════════════════════════

# Enable memory optimization
# NODE_OPTIONS=--max-old-space-size=512

# Enable detailed profiling (performance impact)
# NODE_DEBUG=http,mongodb,pg
